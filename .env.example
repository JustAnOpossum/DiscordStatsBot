# Template for the environment files. Copy to .env.dev and .env.prod and fill in.
# The active file is chosen by APP_ENV (dev or prod); it defaults to dev.
# These files are git-ignored and will NOT be committed.

# Discord application ID (differs per bot/environment)
APP_ID=

# Discord bot token
BOT_TOKEN=

# Bing Image Search API key
BING_KEY=

# Comma separated list of guild IDs to ignore updates from (optional)
BLACKLIST=

# MongoDB connection string
DB_STRING=mongodb://localhost:27017
